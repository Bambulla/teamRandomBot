# Token issued by @Metabot in VK Teams.
BOT_TOKEN=put_token_here

# Optional for on-premise VK Teams installations, for example https://myteam.mail.ru.
BOT_API_URL=https://myteam.mail.ru/bot/v1

LOG_LEVEL=INFO

# Local SQLite database for random-coffee participants, weekly pairs and reactions.
DATABASE_PATH=data/team_random_bot.sqlite3
